<Project Sdk="Microsoft.NET.Sdk">
  <!-- 普通版 ATAS Platform（WPF 渲染）构建。与 C:\AtasBridge\AtasBridge.csproj
       （ATAS X）共用同一份 AtasBridge.cs 源码，不复制维护两份。
       2026-08-09 重建：原 AtasBridge.Platform.csproj 已不存在（CHANGELOG
       v2026.07.06-5 记录过它的存在与约定），按当时记录的做法重建，并补上
       Phase 7L 新增的 OFT.Coinglass 引用。
       必须放在 C:\AtasBridge 目录之外：放在里面的话，主项目（默认 glob 包含
       全部 .cs）会把本项目 obj\ 下自动生成的 AssemblyInfo.cs 也一起编译，
       报一堆 CS0579「特性重复」。
       约定（长期有效）：AtasBridge.dll 每次升级必须同时编译交付 ATAS X 和
       ATAS Platform 两个构建，两边指标目录版本保持同步。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>AtasBridge</AssemblyName>
    <RootNamespace>AtasBridge</RootNamespace>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 普通版 ATAS 是 WPF 渲染，ValueDataSeries.Color 是
         System.Windows.Media.Color（定义在 PresentationCore 里），ATAS X 那边
         则是 System.Drawing.Color。源码用 SeriesColor 别名隔离这个差异，靠
         下面这个编译符号切换。
         注意不能用 <UseWPF>true</UseWPF> 来引入 PresentationCore：那会要求
         TargetFramework 带 -windows 后缀（NETSDK1136），而这里保持 net10.0
         与 ATAS X 构建一致更省事，所以改为在下面直接引用该程序集。 -->
    <DefineConstants>$(DefineConstants);ATAS_PLATFORM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AtasBridge\AtasBridge.cs" />
    <Compile Include="..\AtasBridge\AtasLiquidations.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>D:\Program Files\ATAS Platform\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>D:\Program Files\ATAS Platform\ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>D:\Program Files\ATAS Platform\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>D:\Program Files\ATAS Platform\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Coinglass">
      <HintPath>D:\Program Files\ATAS Platform\OFT.Coinglass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 例外：不引用 ATAS Platform 目录里自带的 System.Drawing.Common.dll，
         那份版本过时会导致 Microsoft.WindowsDesktop.App 版本链解析失败
         （CHANGELOG v2026.07.06-5 记录的 Avalonia 假报错就是这么来的）。 -->
    <Reference Include="System.Drawing.Common">
      <HintPath>C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App\10.0.10\System.Drawing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ValueDataSeries.Color 在普通版 ATAS 是 System.Windows.Media.Color，
         定义在这里（见上方 PropertyGroup 的说明） -->
    <Reference Include="PresentationCore">
      <HintPath>C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App\10.0.10\PresentationCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 普通版 ATAS 的指标目录，与 ATAS X 的 %APPDATA%\ATAS X\Indicators 分开 -->
  <Target Name="CopyToATASPlatform" AfterTargets="Build">
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(APPDATA)\ATAS\Indicators\"
      OverwriteReadOnlyFiles="true"
      SkipUnchangedFiles="false" />
    <Message Text="AtasBridge.dll -> ATAS\Indicators\ (ATAS Platform)" Importance="high" />
  </Target>
</Project>
