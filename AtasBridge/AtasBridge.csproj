<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>AtasBridge</AssemblyName>
    <RootNamespace>AtasBridge</RootNamespace>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- 2026-08-12（9G）：本项目未关闭 EnableDefaultCompileItems，因此目录下的
       .cs 由默认 glob 自动纳入编译，新增 SweepMarker.cs **不需要**在此显式列出。
       ATAS Platform 那个 csproj 不一样：它设了 EnableDefaultCompileItems=false
       并逐个列出源文件，新增文件必须同步加进它的 <Compile> 列表，否则会出现
       "ATAS X 有 SweepMarker、Platform 没有" 的双平台不一致。 -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>D:\Program Files\ATAS X\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>D:\Program Files\ATAS X\ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>D:\Program Files\ATAS X\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>D:\Program Files\ATAS X\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>D:\Program Files\ATAS X\System.Drawing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Phase 7L: Coinglass 三路数据（OI / 多空比 / 聚合爆仓）。ATAS 自带的
         三个 Crypto Metrics 指标就是从这个程序集的 Provider 取数的，接口
         在 ATAS X (8.0.14.646) 和 ATAS Platform (8.0.14.297) 两套 SDK 上
         逐项一致，因此双平台共用同一份源码、无需 #if 分支。
         Private=false：运行时用 ATAS 自己加载的那份，不复制到指标目录。 -->
    <Reference Include="OFT.Coinglass">
      <HintPath>D:\Program Files\ATAS X\OFT.Coinglass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 编译后自动复制 DLL 到 ATAS X 指标目录 -->
  <Target Name="CopyToATAS" AfterTargets="Build">
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(APPDATA)\ATAS X\Indicators\"
      OverwriteReadOnlyFiles="true"
      SkipUnchangedFiles="false" />
    <Message Text="AtasBridge.dll -> ATAS X\Indicators\" Importance="high" />
  </Target>
</Project>
